# Copy to .env.development (local) and set the same values in your host's dashboard
# for production. Both files are gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# /meet storage  (REQUIRED in production — pick ONE)
# ---------------------------------------------------------------------------
# Without one of these, meetings go to a local file. Fine for `npm run develop`;
# on a serverless host each request can get a fresh container with an empty
# disk, so meetings would vanish. Check GET /api/meet/health after deploying:
# you want "durable": true.
#
# Option A (recommended) — Upstash Redis. Free tier, two values, scoped to one
# database. From https://console.upstash.com -> your database -> "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B — Netlify Blobs. Netlify normally wires this up with no config, but
# Gatsby Functions compile to a runtime that does not receive the Blobs context
# (verified on a deploy preview), so it needs a token supplied by hand. SITE_ID
# is provided by Netlify automatically; create a personal access token at
# https://app.netlify.com/user/applications and set it here. Note this grants
# broader access than the Upstash option, which is why A is recommended.
NETLIFY_BLOBS_TOKEN=

# Optional: pin the local file store somewhere durable instead of the OS temp dir.
# MEET_DATA_DIR=./.meet-data

# ---------------------------------------------------------------------------
# /meet Google Calendar import  (OPTIONAL)
# ---------------------------------------------------------------------------
# An OAuth 2.0 Web application client ID from https://console.cloud.google.com
# with the Google Calendar API enabled. Without it the "Import Google Calendar"
# button is hidden; .ics upload and manual entry still work.
GATSBY_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Notion-backed events (pre-existing)
# ---------------------------------------------------------------------------
GATSBY_NOTION_TOKEN=
GATSBY_NOTION_DATABASE_ID=
