# Copy to backend/.env. Run from the repo root with `npm run dev:api`.
# Existing shell/deployment environment variables take precedence over this file.
HOST=127.0.0.1
PORT=8080
FRONTEND_ORIGIN=http://localhost:8000

# Server-only: copy the database URL from `npx supabase status`.
# sslmode=disable is for the local Docker database only.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:54322/postgres?sslmode=disable

# /health connects directly to Postgres. No Supabase admin or storage keys needed.
