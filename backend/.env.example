# Copy to backend/.env. Run from the repo root with `npm run dev:api`.
# Existing shell/deployment environment variables take precedence over this file.
HOST=127.0.0.1
PORT=8080
FRONTEND_ORIGIN=http://localhost:8000

# Expected JWT issuer. JWKS are fetched from this URL + /.well-known/jwks.json.
SUPABASE_AUTH_URL=http://127.0.0.1:54321/auth/v1

# Server-only: copy the database URL from `npx supabase status`.
# sslmode=disable is for the local Docker database only.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:54322/postgres?sslmode=disable

# /health connects directly to Postgres. No Supabase admin or storage keys needed.

# Calendar delivery is disabled by default; CRM saves still work. See docs/EVENTS.md.
# Use google only on a server configured with a dedicated service account.
GOOGLE_CALENDAR_MODE=disabled
# Server-only optional staging/test override; otherwise uses the fixed CSC calendar.
# GOOGLE_CALENDAR_ID=YOUR_NONPRODUCTION_CALENDAR_ID
# Optional mounted service-account credentials; Cloud Run can use its service identity.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
